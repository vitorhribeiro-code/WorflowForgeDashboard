# Base
DATABASE_URL=postgres://app:app@localhost:5432/automacoes
AUTH_SECRET=            # openssl rand -base64 48
ENCRYPTION_KEY=         # openssl rand -hex 32  (AES-256-GCM, credenciais OAuth do M6)
CRON_SECRET=            # openssl rand -base64 24
SESSION_TTL_SECONDS=28800
APP_BASE_URL=http://localhost:3000

# Storage (R2/S3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@localhost

# OAuth (M6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
